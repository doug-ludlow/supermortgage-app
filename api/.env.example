# Local development against `docker compose up` (Postgres + the Firebase Auth emulator).
PORT=8080
DATABASE_URL=postgresql://app:app@127.0.0.1:5432/app
GOOGLE_CLOUD_PROJECT=demo-supermortgage
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
ENVIRONMENT=local
MAIL_STUB=1
MAIL_FROM=Supermortgage <code@mail.supermortgage.com>
EMAIL_CODE_PEPPER=local-only-pepper-change-me-in-the-cloud
# EMAIL_API_KEY is only needed when MAIL_STUB is off (Resend).
