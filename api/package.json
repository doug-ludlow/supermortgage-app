{
  "name": "supermortgage-api",
  "version": "0.1.0",
  "private": true,
  "description": "The Supermortgage API: accounts, households, agents and onboarding. TypeScript on Node 22, Fastify, Postgres 16.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && node dist/tools/openapi-write.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "openapi": "tsx src/tools/openapi-write.ts",
    "gen:swift": "tsx src/tools/gen-swift.ts",
    "test": "vitest run",
    "emulator": "npx --yes firebase-tools@15 emulators:start --only auth --project demo-supermortgage"
  },
  "dependencies": {
    "@fastify/swagger": "^9.8.1",
    "fastify": "^5.12.5",
    "fastify-type-provider-zod": "^7.0.0",
    "firebase-admin": "^14.4.0",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
